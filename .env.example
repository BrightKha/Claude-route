# =============================================================================
# polymarket-bot environment template. PLACEHOLDERS ONLY.
# Copy to `.env` (git-ignored) or, better, inject via your secret manager.
# NEVER paste real values into chats, prompts, issues, logs or commits.
# See docs/security.md for how to generate credentials without exposing them.
# =============================================================================

# ---- Mode flags (safe defaults) ---------------------------------------------
# disabled | paper | replay | live
TRADING_MODE=disabled
# Must be exactly "true" (plus every other live precondition) to allow LIVE.
LIVE_TRADING_ENABLED=false
# Must equal the phrase printed by `make live-readiness` for the CURRENT risk policy hash.
LIVE_CONFIRMATION=
# Operator attestation that the operator is physically located in a jurisdiction
# where Polymarket trading is permitted (ISO country code, e.g. "CH").
# Checked against the blocked list in configs; see docs/security.md "Compliance".
OPERATOR_JURISDICTION=

DATA_SOURCE=polymarket
LOG_LEVEL=INFO
BOT_DATA_DIR=./data

# ---- Polymarket live credentials (read ONLY by adapters/polymarket_live.py) ---
# Dedicated bot wallet. Never your main wallet. Fund with a small amount only.
POLYMARKET_PRIVATE_KEY=
# Explicit, already-deployed wallet address the bot trades for (required:
# prevents the SDK from deploying a new wallet implicitly).
POLYMARKET_WALLET_ADDRESS=
# L2 API credentials (optional: derived from the key when empty).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Claude (read ONLY by llm/claude_client.py) ------------------------------
ANTHROPIC_API_KEY=

# ---- MCP HTTP transport (optional; stdio is the default and needs no token) ---
MCP_HTTP_TOKEN=
